{"id":"39e0c106_1","sourceFile":"frontend/hooks/useSearch.ts","type":"Object: useSearch","content":"# Source: frontend/hooks/useSearch.ts\n# Lines: 98-170\n# Type: Object: useSearch\n\n```typescript\n}, [userToken, on401, refreshUserInfo, onTopUp]);\r\n\r\n  // 确认后搜索（先询价，再弹窗确认）\r\n  const confirmAndSearch = useCallback(async (\r\n    from: string,\r\n    to: string,\r\n    startDate: string,\r\n    days: number = 30,\r\n    options?: SearchRequestOptions\r\n  ) => {\r\n    const trimFrom = from.trim().toUpperCase();\r\n    const trimTo = to.trim().toUpperCase();\r\n    const trimDate = startDate.trim();\r\n\r\n    if (trimFrom.length !== 3 || trimTo.length !== 3) {\r\n      Alert.alert('Error', 'IATA code must be 3 letters (e.g. JFK, PVG)');\r\n      return;\r\n    }\r\n    if (trimFrom === trimTo) {\r\n      Alert.alert('Error', 'Origin and destination cannot be the same');\r\n      return;\r\n    }\r\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(trimDate)) {\r\n      Alert.alert('Error', 'Date must be YYYY-MM-DD format');\r\n      return;\r\n    }\r\n\r\n    // 先询价获取真实费用\r\n    const quote = await fetchQuote(days);\r\n    const cost = quote?.cost ?? calculateSearchCost(days);\r\n    const balance = quote?.user_credits ?? userCredits;\r\n    const sufficient = quote?.sufficient ?? (balance >= cost);\r\n\r\n    if (!sufficient) {\r\n      Alert.alert(\r\n        '💎 Insufficient Credits',\r\n        `This search costs ${cost} credit(s).\\nYour balance: 💎 ${balance}\\n\\nPlease top up first.`,\r\n        [\r\n          { text: 'Cancel', style: 'cancel' },\r\n          { text: 'Top Up', onPress: onTopUp },\r\n        ],\r\n      );\r\n      return;\r\n    }\r\n\r\n    const modeLabel = days === 1 ? 'Fixed Date' : `Range ${days} Days`;\r\n    if (Platform.OS === 'web' && typeof window !== 'undefined') {\r\n      const confirmed = window.confirm(\r\n        `Search ${trimFrom} → ${trimTo} from ${trimDate}?\\n\\nMode: ${modeLabel}\\nThis [${modeLabel}] search will cost ${cost} Credit(s). Continue?\\n\\nBalance: 💎 ${balance}\\nAfter: 💎 ${balance - cost}`,\r\n      );\r\n      if (confirmed) performSearch(trimFrom, trimTo, trimDate, days, options);\r\n    } else {\r\n      Alert.alert(\r\n        '🔍 Confirm Search',\r\n        `${trimFrom} → ${trimTo} from ${trimDate}\\n\\nMode: ${modeLabel}\\nThis [${modeLabel}] search will cost ${cost} Credit(s). Continue?\\n\\nBalance: 💎 ${balance}\\nAfter: 💎 ${balance - cost}`,\r\n        [\r\n          { text: 'Cancel', style: 'cancel' },\r\n          { text: 'Search', onPress: () => performSearch(trimFrom, trimTo, trimDate, days, options) },\r\n        ],\r\n      );\r\n    }\r\n  }, [fetchQuote, userCredits, performSearch, onTopUp]);\r\n\r\n  return {\r\n    searchResult,\r\n    loading,\r\n    error,\r\n    fetchQuote,\r\n    performSearch,\r\n    confirmAndSearch,\r\n    setSearchResult,\r\n  };\r\n};\n```\n","vector":[-0.053421396762132645,0.08022736012935638,0.031592123210430145,0.0864408016204834,-0.0212384182959795,0.04320133849978447,0.045283421874046326,0.0943579152226448,0.010314355604350567,-0.016884397715330124,-0.04450521990656853,-0.0779099315404892,-0.010037566535174847,-0.05831890180706978,-0.011636245995759964,-0.026541348546743393,-0.09165967255830765,-0.0006409554043784738,-0.008853781037032604,-0.03848668932914734,0.0770418792963028,-0.005020656622946262,0.018594330176711082,-0.007982859387993813,-0.0024245837703347206,-0.00038002515793778,0.0019936379976570606,-0.047847647219896317,-0.037383705377578735,0.04211505129933357,-0.01840307004749775,0.01697148010134697,0.01712803542613983,0.023277005180716515,-0.05582796782255173,0.0250772126019001,-0.05732784792780876,-0.02572355791926384,0.0347653292119503,-0.012963330373167992,-0.06525098532438278,0.047298114746809006,-0.016924548894166946,-0.05468368902802467,0.07037000358104706,-0.11705318838357925,-0.0927901491522789,0.022143807262182236,0.02915213629603386,0.06810884922742844,-0.030051246285438538,-0.022124608978629112,0.00160355