n = value.length - curOffset;\n    if (curLen > byteBuffer.length) {\n      curLen = byteBuffer.length;\n    }\n    byteBuffer.set(value.subarray(curOffset, curOffset + curLen), 0);\n\n    Atomics.store(intBuffer, 0, curLen); // store current length in bytes\n    Atomics.notify(intBuffer, 0);\n    curOffset += curLen;\n    connections.get(connectionID).curOffset = curOffset;\n```\n","vector":[-0.032024085521698,-0.01584397442638874,-0.0156860388815403,0.04875168949365616,-0.013472761027514935,-0.014705033972859383,-0.009627300314605236,0.029258063063025475,0.02331392653286457,-0.03197340667247772,-0.03031979687511921,-0.02941545844078064,-0.07768559455871582,-0.05940817669034004,-0.011368583887815475,0.0259088147431612,0.03053354285657406,-0.0183433648198843,-0.057688891887664795,-0.05459051951766014,0.06292247772216797,-0.006731433793902397,0.04755844548344612,-0.004791504703462124,-0.04181341826915741,-0.03592914715409279,-0.018767060711979866,-0.06554264575242996,0.000035851349821314216,-0.030365094542503357,0.058502696454524994,-0.0708254873752594,-0.10026346147060394,0.0024005004670470953,0.041695404797792435,0.0490545891225338,-0.01554165966808796,-0.025932569056749344,-0.07513447105884552,-0.03708610683679581,-0.007633510511368513,0.07129513472318649,-0.08750247210264206,0.04008248820900917,0.013953707180917263,-0.08439042419195175,-0.05908343940973282,-0.06318105012178421,0.01451997272670269,0.0095693813636899,0.0006236290792003274,0.05752021074295044,-0.032532237470149994,0.04249778017401695,0.10567668080329895,-0.0017176775727421045,-0.030371131375432014,0.014239925891160965,-0.05454079434275627,0.0404222346842289,0.021393362432718277,-0.07430891692638397,0.04261581227183342,-0.0647611990571022,-0.001924164011143148,0.035546980798244476,0.047914616763591766,0.00933188945055008,0.00010780724551295862,-0.002401043428108096,-0.044724248349666595,0.01209568977355957,-0.07101774960756302,0.0017721401527523994,-0.025989368557929993,-0.011526406742632389,0.023536