{"id":"2779874c_2","sourceFile":"frontend/app/auth/signup.tsx","type":"Source Code","content":"# Source: frontend/app/auth/signup.tsx\n# Lines: 1-102\n# Type: Source Code\n\n```typescript\n// filename: app/auth/signup.tsx\r\nimport React, { useState } from 'react';\r\nimport {\r\n  View,\r\n  Text,\r\n  TextInput,\r\n  TouchableOpacity,\r\n  StyleSheet,\r\n  ActivityIndicator,\r\n  Alert,\r\n} from 'react-native';\r\nimport { useRouter } from 'expo-router';\r\nimport { useAuth } from '../../hooks/useAuth';\r\n\r\nexport default function SignupScreen() {\r\n  const router = useRouter();\r\n  const { signup } = useAuth();\r\n  const [email, setEmail] = useState('');\r\n  const [password, setPassword] = useState('');\r\n  const [fullName, setFullName] = useState('');\r\n  const [loading, setLoading] = useState(false);\r\n\r\n  const handleSignup = async () => {\r\n    if (!email.trim() || !password.trim()) {\r\n      Alert.alert('Error', 'Please enter email and password');\r\n      return;\r\n    }\r\n    if (password.length < 6) {\r\n      Alert.alert('Error', 'Password must be at least 6 characters');\r\n      return;\r\n    }\r\n    setLoading(true);\r\n    const result = await signup(email.trim(), password, fullName.trim() || undefined);\r\n    setLoading(false);\r\n    if (result.success && result.requiresVerification) {\r\n      router.replace(`/auth/verify-email?email=${encodeURIComponent(result.email || email.trim())}`);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <View style={styles.container}>\r\n      <View style={styles.card}>\r\n        <Text style={styles.title}>📝 SIGN UP</Text>\r\n\r\n        <Text style={styles.label}>Full Name (Optional)</Text>\r\n        <TextInput\r\n          style={styles.input}\r\n          value={fullName}\r\n          onChangeText={setFullName}\r\n          placeholder=\"John Doe\"\r\n          placeholderTextColor=\"#666\"\r\n        />\r\n\r\n        <Text style={styles.label}>Email</Text>\r\n        <TextInput\r\n          style={styles.input}\r\n          value={email}\r\n          onChangeText={setEmail}\r\n          placeholder=\"your@email.com\"\r\n          placeholderTextColor=\"#666\"\r\n          keyboardType=\"email-address\"\r\n          autoCapitalize=\"none\"\r\n          autoCorrect={false}\r\n        />\r\n\r\n        <Text style={styles.label}>Password</Text>\r\n        <TextInput\r\n          style={styles.input}\r\n          value={password}\r\n          onChangeText={setPassword}\r\n          placeholder=\"••••••••\"\r\n          placeholderTextColor=\"#666\"\r\n          secureTextEntry\r\n        />\r\n\r\n        <TouchableOpacity\r\n          style={[styles.button, loading && styles.buttonDisabled]}\r\n          onPress={handleSignup}\r\n          disabled={loading}\r\n        >\r\n          {loading ? (\r\n            <ActivityIndicator color=\"#000\" />\r\n          ) : (\r\n            <Text style={styles.buttonText}>SIGN UP</Text>\r\n          )}\r\n        </TouchableOpacity>\r\n\r\n        <View style={styles.footer}>\r\n          <TouchableOpacity onPress={() => router.push('/auth/login')}>\r\n            <Text style={styles.linkText}>Already have an account? Login</Text>\r\n          </TouchableOpacity>\r\n        </View>\r\n      </View>\r\n    </View>\r\n  );\r\n}\r\n\r\nconst styles = StyleSheet.create({\r\n  container: {\r\n    flex: 1,\r\n    backgroundColor: '#000000',\n```\n","vector":[-0.05253307521343231,0.06267927587032318,0.019281119108200073,0.008269190788269043,0.03453134745359421,0.035361193120479584,0.02277453802525997,0.08463599532842636,0.004446750041097403,-0.0020101715344935656,-0.05175546556711197,-0.010560395196080208,-0.06401655822992325,0.04471168667078018,0.031296826899051666,0.05855183303356171,-0.0511767752468586,-0.032894063740968704,-0.01713341660797596,-0.011998736299574375,0.030257588252425194,-0.07961665838956833,0.09649937599897385,0.00039826941792853177,0.05373510718345642,-0.04483877867460251,0.06242172047495842,-0.0736120119