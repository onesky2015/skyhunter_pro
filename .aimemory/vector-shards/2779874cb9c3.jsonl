{"id":"2779874c_0","sourceFile":"frontend/app/auth/signup.tsx","type":"Function: SignupScreen","content":"# Source: frontend/app/auth/signup.tsx\n# Lines: 15-97\n# Type: Function: SignupScreen\n\n```typescript\nexport default function SignupScreen() {\r\n  const router = useRouter();\r\n  const { signup } = useAuth();\r\n  const [email, setEmail] = useState('');\r\n  const [password, setPassword] = useState('');\r\n  const [fullName, setFullName] = useState('');\r\n  const [loading, setLoading] = useState(false);\r\n\r\n  const handleSignup = async () => {\r\n    if (!email.trim() || !password.trim()) {\r\n      Alert.alert('Error', 'Please enter email and password');\r\n      return;\r\n    }\r\n    if (password.length < 6) {\r\n      Alert.alert('Error', 'Password must be at least 6 characters');\r\n      return;\r\n    }\r\n    setLoading(true);\r\n    const result = await signup(email.trim(), password, fullName.trim() || undefined);\r\n    setLoading(false);\r\n    if (result.success && result.requiresVerification) {\r\n      router.replace(`/auth/verify-email?email=${encodeURIComponent(result.email || email.trim())}`);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <View style={styles.container}>\r\n      <View style={styles.card}>\r\n        <Text style={styles.title}>📝 SIGN UP</Text>\r\n\r\n        <Text style={styles.label}>Full Name (Optional)</Text>\r\n        <TextInput\r\n          style={styles.input}\r\n          value={fullName}\r\n          onChangeText={setFullName}\r\n          placeholder=\"John Doe\"\r\n          placeholderTextColor=\"#666\"\r\n        />\r\n\r\n        <Text style={styles.label}>Email</Text>\r\n        <TextInput\r\n          style={styles.input}\r\n          value={email}\r\n          onChangeText={setEmail}\r\n          placeholder=\"your@email.com\"\r\n          placeholderTextColor=\"#666\"\r\n          keyboardType=\"email-address\"\r\n          autoCapitalize=\"none\"\r\n          autoCorrect={false}\r\n        />\r\n\r\n        <Text style={styles.label}>Password</Text>\r\n        <TextInput\r\n          style={styles.input}\r\n          value={password}\r\n          onChangeText={setPassword}\r\n          placeholder=\"••••••••\"\r\n          placeholderTextColor=\"#666\"\r\n          secureTextEntry\r\n        />\r\n\r\n        <TouchableOpacity\r\n          style={[styles.button, loading && styles.buttonDisabled]}\r\n          onPress={handleSignup}\r\n          disabled={loading}\r\n        >\r\n          {loading ? (\r\n            <ActivityIndicator color=\"#000\" />\r\n          ) : (\r\n            <Text style={styles.buttonText}>SIGN UP</Text>\r\n          )}\r\n        </TouchableOpacity>\r\n\r\n        <View style={styles.footer}>\r\n          <TouchableOpacity onPress={() => router.push('/auth/login')}>\r\n            <Text style={styles.linkText}>Already have an account? Login</Text>\r\n          </TouchableOpacity>\r\n        </View>\r\n      </View>\r\n    </View>\r\n  );\r\n}\n```\n","vector":[-0.0665934607386589,0.06208645552396774,0.019104275852441788,0.029834551736712456,0.024175412952899933,0.04149123653769493,0.028661828488111496,0.06099977344274521,0.004432921297848225,-0.013640297576785088,-0.07391010969877243,0.012951760552823544,-0.040223684161901474,0.005654440261423588,0.018539469689130783,0.07666127383708954,-0.046525727957487106,-0.01534624770283699,-0.027300426736474037,-0.023060867562890053,0.0051909866742789745,-0.08461402356624603,0.06179887056350708,0.01294065359979868,0.03961266949772835,-0.03014913760125637,0.054177336394786835,-0.07648930698633194,-0.04172806069254875,0.025110170245170593,0.005466103088110685,0.01918955147266388,-0.023093216121196747,-0.04199724271893501,-0.10043975710868835,-0.021940460428595543,-0.09771385043859482,-0.0361056849360466,0.00003730420212377794,-0.059566713869571686,-0.06172938272356987,0.0650496855378151,-0.02838376723229885,-0.0014438474318012595,0.020863652229309082,-0.04049838334321976,-0.05698501318693161,0.045233