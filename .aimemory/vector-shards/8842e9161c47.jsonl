{"id":"8842e916_2","sourceFile":"frontend/components/CabinSelector.tsx","type":"Source Code","content":"# Source: frontend/components/CabinSelector.tsx\n# Lines: 1-81\n# Type: Source Code\n\n```typescript\nimport React from 'react';\r\nimport { View, Text, TouchableOpacity, StyleSheet } from 'react-native';\r\n\r\ninterface CabinSelectorProps {\r\n  value: string;\r\n  onChange: (val: string) => void;\r\n  small?: boolean;\r\n}\r\n\r\nexport const CabinSelector: React.FC<CabinSelectorProps> = ({ value, onChange, small }) => {\r\n  const options = [\r\n    { value: 'economy', label: '💺 Economy' },\r\n    { value: 'premium_economy', label: '💺+ Premium' },\r\n    { value: 'business', label: '💼 Business' },\r\n    { value: 'first', label: '💎 First' },\r\n  ];\r\n\r\n  return (\r\n    <View style={styles.container}>\r\n      {options.map((c) => (\r\n        <TouchableOpacity\r\n          key={c.value}\r\n          style={[\r\n            styles.button,\r\n            small && styles.buttonSmall,\r\n            value === c.value && styles.buttonActive,\r\n          ]}\r\n          onPress={() => onChange(c.value)}\r\n        >\r\n          <Text\r\n            style={[\r\n              styles.text,\r\n              small && styles.textSmall,\r\n              value === c.value && styles.textActive,\r\n            ]}\r\n          >\r\n            {c.label}\r\n          </Text>\r\n        </TouchableOpacity>\r\n      ))}\r\n    </View>\r\n  );\r\n};\r\n\r\nconst styles = StyleSheet.create({\r\n  container: {\r\n    flexDirection: 'row',\r\n    gap: 6,\r\n    marginBottom: 12,\r\n    flexWrap: 'wrap',\r\n  },\r\n  button: {\r\n    flex: 1,\r\n    minWidth: 70,\r\n    padding: 12,\r\n    borderRadius: 8,\r\n    backgroundColor: '#222222',\r\n    alignItems: 'center',\r\n    borderWidth: 1,\r\n    borderColor: '#333333',\r\n  },\r\n  buttonSmall: {\r\n    padding: 8,\r\n  },\r\n  buttonActive: {\r\n    backgroundColor: '#00FF00',\r\n    borderColor: '#00FF00',\r\n  },\r\n  text: {\r\n    color: '#666666',\r\n    fontSize: 12,\r\n    fontWeight: '600',\r\n  },\r\n  textSmall: {\r\n    fontSize: 10,\r\n  },\r\n  textActive: {\r\n    color: '#000000',\r\n  },\r\n});\n```\n","vector":[-0.016701746731996536,0.05305936560034752,0.03088747337460518,0.10241412371397018,0.03799184039235115,0.12064232677221298,0.046038608998060226,0.04240776598453522,0.007232483942061663,0.02886963076889515,-0.01692391186952591,-0.02046351134777069,-0.10868898779153824,0.002254210412502289,0.08943706005811691,0.03806821256875992,-0.07784081250429153,-0.07778912782669067,-0.04723193496465683,0.011667877435684204,0.033201511949300766,-0.03650808706879616,0.04825017228722572,-0.03499981388449669,-0.009983363561332226,0.059261295944452286,0.04367528110742569,0.011908680200576782,0.0003894153342116624,-0.032081760466098785,-0.06696142256259918,0.05949464812874794,-0.0006021530134603381,0.0020050974562764168,-0.02101769670844078,-0.00041211419738829136,-0.050693806260824203,-0.02683217078447342,0.020750071853399277,-0.009409058839082718,-0.031367067247629166,0.037208858877420425,-0.003257730044424534,-0.07154757529497147,0.019406279549002647,-0.0160283874720335,-0.015014122240245342,0.011891590431332588,0.03962082415819168,0.037501201033592224,-0.005304642021656036,0.06571825593709946,0.029308870434761047,-0.04879187420010567,0.03931396082043648,0.05236106365919113,-0.007686140015721321,-0.00784187950193882,0.04988418519496918,-0.007016925606876612,0.014233014546334743,-0.024351296946406364,0.06111079081892967,-0.048179756850004196,0.04145390912890434,0.030412854626774788,-0.026425130665302277,0.07667766511440277,-0.07486840337514877,0.017520712688565254,0.03235781565308571,-0.003690947312861681,0.07547011971473694,-0.02479434385895729,0.022458648309111595,-0.1420186161994934,0.009743332862854004,0.01458306610584259,0.025749359279870987,0.052727844566106796,-0.06951233744621277,-0.07573410123586655,-0.09256017953157425,0.038214895874261856,-0.05507201701402664,0.03253653