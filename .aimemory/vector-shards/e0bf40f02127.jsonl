{"id":"e0bf40f0_3","sourceFile":"frontend/components/TimeRangeSlider.tsx","type":"Source Code","content":"# Source: frontend/components/TimeRangeSlider.tsx\n# Lines: 1-99\n# Type: Source Code\n\n```typescript\n// filename: components/TimeRangeSlider.tsx\r\nimport React from 'react';\r\nimport { View, Text, StyleSheet, Platform } from 'react-native';\r\nimport MultiSlider from '@ptomasroos/react-native-multi-slider';\r\nimport { minutesToTimeStr } from '../constants/utils';\r\n\r\ninterface TimeRangeSliderProps {\r\n  label: string;\r\n  value: [number, number];\r\n  onChange: (value: [number, number]) => void;\r\n  min?: number;\r\n  max?: number;\r\n  step?: number;\r\n}\r\n\r\nconst SLIDER_LENGTH = Platform.OS === 'web' ? 300 : 250;\r\n\r\nexport const TimeRangeSlider: React.FC<TimeRangeSliderProps> = ({\r\n  label,\r\n  value,\r\n  onChange,\r\n  min = 0,\r\n  max = 1440,\r\n  step = 30,\r\n}) => {\r\n  return (\r\n    <View style={styles.container}>\r\n      <Text style={styles.label}>{label}</Text>\r\n      <Text style={styles.valueText}>\r\n        {minutesToTimeStr(value[0])} — {minutesToTimeStr(value[1])}\r\n      </Text>\r\n      <View style={styles.sliderWrapper}>\r\n        <Text style={styles.boundLabel}>00:00</Text>\r\n        <View style={styles.sliderContainer}>\r\n          <MultiSlider\r\n            values={value}\r\n            min={min}\r\n            max={max}\r\n            step={step}\r\n            sliderLength={SLIDER_LENGTH}\r\n            onValuesChange={(values: number[]) => onChange([values[0], values[1]])}\r\n            selectedStyle={{ backgroundColor: '#00FF00', height: 4 }}\r\n            unselectedStyle={{ backgroundColor: '#333', height: 4 }}\r\n            trackStyle={{ height: 4, backgroundColor: '#333' }}\r\n            markerStyle={{\r\n              backgroundColor: '#ffffff',\r\n              height: 28,\r\n              width: 28,\r\n              borderRadius: 14,\r\n              borderWidth: 2,\r\n              borderColor: '#00FF00',\r\n              elevation: 6,\r\n            }}\r\n            minMarkerOverlapDistance={40}\r\n            snapped\r\n          />\r\n        </View>\r\n        <Text style={styles.boundLabel}>24:00</Text>\r\n      </View>\r\n    </View>\r\n  );\r\n};\r\n\r\nconst styles = StyleSheet.create({\r\n  container: {\r\n    marginBottom: 20,\r\n  },\r\n  label: {\r\n    color: '#00FF00',\r\n    fontSize: 12,\r\n    fontWeight: '600',\r\n    marginBottom: 8,\r\n    textTransform: 'uppercase',\r\n  },\r\n  valueText: {\r\n    color: '#FFFFFF',\r\n    fontSize: 14,\r\n    fontWeight: '600',\r\n    marginBottom: 12,\r\n  },\r\n  sliderWrapper: {\r\n    flexDirection: 'row',\r\n    alignItems: 'center',\r\n    gap: 8,\r\n  },\r\n  boundLabel: {\r\n    color: '#666666',\r\n    fontSize: 10,\r\n    width: 40,\r\n    textAlign: 'center',\r\n  },\r\n  sliderContainer: {\r\n    flex: 1,\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n  },\r\n});\n```\n","vector":[-0.03085445798933506,0.026354463770985603,0.05650370940566063,0.05431823059916496,-0.0028994157910346985,0.10307979583740234,0.03721250966191292,0.06456416100263596,0.05994895473122597,-0.06518830358982086,-0.08004147559404373,-0.0666007474064827,-0.0472230389714241,-0.006648202892392874,0.024524644017219543,0.01178409531712532,-0.09147699177265167,-0.03646038472652435,-0.033889040350914,-0.09345455467700958,0.003775388468056917,-0.04112733155488968,0.07086378335952759,0.03314189612865448,-0.020548133179545403,0.06697442382574081,-0.0007249849149957299,-0.03998330235481262,0.04892361909151077,0.011784406378865242,-0.01429538894444704,0.036898963153362274,-0.04981283098459244,0.008014744147658348,-0.08554811775684357,-0.024477409198880196,-0.09407885372638702,-0.002701787045225501,0.005886176135390997,0.04206667095422745,0.04403582960367203,0.03008718229830265,-0.03178717568516731,-0.09564054012298584,-0.029630955308675766,-0.004857661202549934,-0.05554485321044922,-0.07379518449306488,-0.05