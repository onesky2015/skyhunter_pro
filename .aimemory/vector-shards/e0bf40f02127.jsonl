{"id":"e0bf40f0_1","sourceFile":"frontend/components/TimeRangeSlider.tsx","type":"Object: TimeRangeSlider","content":"# Source: frontend/components/TimeRangeSlider.tsx\n# Lines: 18-62\n# Type: Object: TimeRangeSlider\n\n```typescript\nexport const TimeRangeSlider: React.FC<TimeRangeSliderProps> = ({\r\n  label,\r\n  value,\r\n  onChange,\r\n  min = 0,\r\n  max = 1440,\r\n  step = 30,\r\n}) => {\r\n  return (\r\n    <View style={styles.container}>\r\n      <Text style={styles.label}>{label}</Text>\r\n      <Text style={styles.valueText}>\r\n        {minutesToTimeStr(value[0])} — {minutesToTimeStr(value[1])}\r\n      </Text>\r\n      <View style={styles.sliderWrapper}>\r\n        <Text style={styles.boundLabel}>00:00</Text>\r\n        <View style={styles.sliderContainer}>\r\n          <MultiSlider\r\n            values={value}\r\n            min={min}\r\n            max={max}\r\n            step={step}\r\n            sliderLength={SLIDER_LENGTH}\r\n            onValuesChange={(values: number[]) => onChange([values[0], values[1]])}\r\n            selectedStyle={{ backgroundColor: '#00FF00', height: 4 }}\r\n            unselectedStyle={{ backgroundColor: '#333', height: 4 }}\r\n            trackStyle={{ height: 4, backgroundColor: '#333' }}\r\n            markerStyle={{\r\n              backgroundColor: '#ffffff',\r\n              height: 28,\r\n              width: 28,\r\n              borderRadius: 14,\r\n              borderWidth: 2,\r\n              borderColor: '#00FF00',\r\n              elevation: 6,\r\n            }}\r\n            minMarkerOverlapDistance={40}\r\n            snapped\r\n          />\r\n        </View>\r\n        <Text style={styles.boundLabel}>24:00</Text>\r\n      </View>\r\n    </View>\r\n  );\r\n};\n```\n","vector":[-0.050090812146663666,0.043174318969249725,0.053403835743665695,0.07725483924150467,0.008448277600109577,0.11397315561771393,0.03992917016148567,0.048067834228277206,0.08260185271501541,-0.07130806148052216,-0.08216884732246399,-0