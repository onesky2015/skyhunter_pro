{"id":"ce295b58_3","sourceFile":"frontend/hooks/useMonitors.ts","type":"Source Code","content":"# Source: frontend/hooks/useMonitors.ts\n# Lines: 85-154\n# Type: Source Code\n\n```typescript\nif (errMsg.includes('Insufficient credits') || errMsg.includes('402')) {\r\n        Alert.alert('💎 积分不足', '积分不足，请先充值后再修改。');\r\n      } else {\r\n        Alert.alert('Failed', errMsg);\r\n      }\r\n      return false;\r\n    }\r\n  }, [userToken, on401, fetchMonitors, refreshUserInfo]);\r\n\r\n  // 删除监控任务\r\n  const deleteMonitor = useCallback(async (id: number) => {\r\n    try {\r\n      await monitorApi.deleteMonitor(userToken, id, on401);\r\n      setMonitors((prev) => prev.filter((m) => m.id !== id));\r\n    } catch (err) {\r\n      console.error('删除失败:', err);\r\n    }\r\n  }, [userToken, on401]);\r\n\r\n  // 恢复监控任务\r\n  const restoreMonitor = useCallback(async (id: number) => {\r\n    try {\r\n      await monitorApi.restoreMonitor(userToken, id, on401);\r\n      setTrashMonitors((prev) => prev.filter((m) => m.id !== id));\r\n      await fetchMonitors();\r\n      Alert.alert('✅ Restored', `Monitor #${id} has been restored.`);\r\n    } catch (err: unknown) {\r\n      Alert.alert('Error', err instanceof Error ? err.message : 'Failed to restore monitor');\r\n    }\r\n  }, [userToken, on401, fetchMonitors]);\r\n\r\n  // 更新监控任务状态\r\n  const updateMonitorStatus = useCallback(async (id: number, status: string) => {\r\n    try {\r\n      await monitorApi.updateStatus(userToken, id, status, on401);\r\n      await fetchMonitors();\r\n    } catch (err) {\r\n      console.error('更新状态失败:', err);\r\n    }\r\n  }, [userToken, on401, fetchMonitors]);\r\n\r\n  // Phase 2: 存档监控任务\r\n  const archiveMonitor = useCallback(async (id: number) => {\r\n    try {\r\n      await monitorApi.updateStatus(userToken, id, 'archived', on401);\r\n      setMonitors((prev) => prev.filter((m) => m.id !== id));\r\n    } catch (err: unknown) {\r\n      Alert.alert('Error', err instanceof Error ? err.message : 'Failed to archive monitor');\r\n    }\r\n  }, [userToken, on401]);\r\n\r\n  return {\r\n    monitors,\r\n    loading,\r\n    refreshing,\r\n    trashMonitors,\r\n    trashLoading,\r\n    fetchMonitors,\r\n    fetchTrashMonitors,\r\n    createMonitor,\r\n    updateMonitor,\r\n    deleteMonitor,\r\n    restoreMonitor,\r\n    updateMonitorStatus,\r\n    archiveMonitor,\r\n    setRefreshing,\r\n  };\r\n};\n```\n","vector":[-0.03762966766953468,0.011817566119134426,0.01159646175801754,0.04304499179124832,0.031576525419950485,0.012361741624772549,0.08160994201898575,0.01431212481111288,0.04674358665943146,-0.005213042721152306,0.00900940503925085,-0.08055388927459717,0.029587555676698685,-0.07118508964776993,-0.025930091738700867,0.006903160363435745,-0.020219294354319572,0.0018741912208497524,-0.06583836674690247,-0.07457393407821655,0.0032146202865988016,-0.010935245081782341,0.04023166373372078,0.0117538096383214,-0.016728922724723816,-0.0064611718989908695,-0.0013722465373575687,-0.061341702938079834,-0.019458841532468796,0.024592842906713486,-0.028878696262836456,-0.038599494844675064,-0.06849300116300583,-0.029140900820493698,-0.044280216097831726,0.0639086663722992,-0.04569105803966522,-0.035669244825839996,-0.04072600603103638,-0.0330314002931118,-0.00029900213121436536,0.08685305714607239,-0.03588375821709633,-0.04364462196826935,0.04792790114879608,-0.09614153206348419,-0.15054742991924286,-0.031134529039263725,-0.01284736581146717,0.02514936961233616,0.03658560663461685,0.029566561803221703,-0.021802330389618874,0.059462644159793854,0.046582285314798355,0.03808259218931198,-0.02144709601998329,0.006671597715467215,-0.00846968125551939,-0.019826190546154976,0.0274876169860363,-0.0867026299238205,0.032579805701971054,-0.07315648347139359,0.04613937437534332,-0.005455485545098782,-0.008022521622478962,-0.018930450081825256,0.03163749724626541,0.04751262068748474,-0.048771344125270844,0.0566222108900547,-0.028858283534646034,-0.034786175936460495,-0.09584692865610