{"id":"ce295b58_1","sourceFile":"frontend/hooks/useMonitors.ts","type":"Object: useMonitors","content":"# Source: frontend/hooks/useMonitors.ts\n# Lines: 95-152\n# Type: Object: useMonitors\n\n```typescript\nconst deleteMonitor = useCallback(async (id: number) => {\r\n    try {\r\n      await monitorApi.deleteMonitor(userToken, id, on401);\r\n      setMonitors((prev) => prev.filter((m) => m.id !== id));\r\n    } catch (err) {\r\n      console.error('删除失败:', err);\r\n    }\r\n  }, [userToken, on401]);\r\n\r\n  // 恢复监控任务\r\n  const restoreMonitor = useCallback(async (id: number) => {\r\n    try {\r\n      await monitorApi.restoreMonitor(userToken, id, on401);\r\n      setTrashMonitors((prev) => prev.filter((m) => m.id !== id));\r\n      await fetchMonitors();\r\n      Alert.alert('✅ Restored', `Monitor #${id} has been restored.`);\r\n    } catch (err: unknown) {\r\n      Alert.alert('Error', err instanceof Error ? err.message : 'Failed to restore monitor');\r\n    }\r\n  }, [userToken, on401, fetchMonitors]);\r\n\r\n  // 更新监控任务状态\r\n  const updateMonitorStatus = useCallback(async (id: number, status: string) => {\r\n    try {\r\n      await monitorApi.updateStatus(userToken, id, status, on401);\r\n      await fetchMonitors();\r\n    } catch (err) {\r\n      console.error('更新状态失败:', err);\r\n    }\r\n  }, [userToken, on401, fetchMonitors]);\r\n\r\n  // Phase 2: 存档监控任务\r\n  const archiveMonitor = useCallback(async (id: number) => {\r\n    try {\r\n      await monitorApi.updateStatus(userToken, id, 'archived', on401);\r\n      setMonitors((prev) => prev.filter((m) => m.id !== id));\r\n    } catch (err: unknown) {\r\n      Alert.alert('Error', err instanceof Error ? err.message : 'Failed to archive monitor');\r\n    }\r\n  }, [userToken, on401]);\r\n\r\n  return {\r\n    monitors,\r\n    loading,\r\n    refreshing,\r\n    trashMonitors,\r\n    trashLoading,\r\n    fetchMonitors,\r\n    fetchTrashMonitors,\r\n    createMonitor,\r\n    updateMonitor,\r\n    deleteMonitor,\r\n    restoreMonitor,\r\n    updateMonitorStatus,\r\n    archiveMonitor,\r\n    setRefreshing,\r\n  };\r\n};\n```\n","vector":[-0.046493545174598694,0.04063189774751663,-0.01073251198977232,0.05565378814935684,0.027926020324230194,0.003126739989966154,0.06575631350278854,-0.015863114967942238,0.03301525488495827,0.015224799513816833,-0.025399096310138702,-0.0678199976682663,0.02308402769267559,-0.057539988309144974,-0.03337099403142929,0.015777289867401123,-0.02649715542793274,0.007398425601422787,-0.07986679673194885,-0.05009976774454117,0.0055509936064481735,-0.028407257050275803,0.009449465200304985,-0.01841983012855053,-0.010553223080933094,-0.004723328165709972,-0.023771796375513077,-0.08681002259254456,0.0006978304008953273,0.03160187974572182,-0.02401142194867134,-0.020729780197143555,-0.10175252705812454,-0.021970748901367188,-0.06389900296926498,0.05417792126536369,-0.029011216014623642,-0.019827427342534065,-0.011196102946996689,-0.048328690230846405,0.044279519468545914,0.09201706945896149,-0.027169665321707726,-0.05292331799864769,-0.005438425112515688,-0.07383576780557632,-0.12448549270629883,-0.025550516322255135,-0.03724249079823494,0.019893797114491463,0.04913809522986412,0.038221828639507294,-0.00783918984234333,0.10745054483413696,0.051839567720890045,0.04638465866446495,-0.049542136490345,-0.011172750033438206,0.00328853284008801,-0.013545171357691288,0.01786215417087078,-0.0928247794508934,0.02181815169751644,-0.06628494709730148,0.0454612672328949,-0.008073956705629826,-0.010377944447100163,-0.026782605797052383,0.06435061246156693,0.042534228414297104,-0.049284677952528,0.05485181137919426,-0.007889064028859138,-0.04326949268579483,-0.055945493280887604,0.03240594640374184,0.05871238932013512,0.026759667322039604,-0.06511514633893967,-0.06825003027915955,-0.024470746517181396,-0.04689957946538925,-0.015341104939579964,0.012178598903119564,0.009089247323572636,0.06010942533612251,-0.059770308434963226,-0.054882608354091644,0.039163727313280106,-