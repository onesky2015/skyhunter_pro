{"id":"ce295b58_2","sourceFile":"frontend/hooks/useMonitors.ts","type":"Source Code","content":"# Source: frontend/hooks/useMonitors.ts\n# Lines: 1-85\n# Type: Source Code\n\n```typescript\n// filename: hooks/useMonitors.ts\r\nimport { useState, useCallback } from 'react';\r\nimport { Alert } from 'react-native';\r\nimport { MonitorTask, MonitorCreatePayload, MonitorUpdatePayload } from '../types';\r\nimport { monitorApi } from '../services/api';\r\n\r\nexport const useMonitors = (userToken: string | null, on401: () => void, refreshUserInfo: () => Promise<void>) => {\r\n  const [monitors, setMonitors] = useState<MonitorTask[]>([]);\r\n  const [loading, setLoading] = useState(false);\r\n  const [refreshing, setRefreshing] = useState(false);\r\n  const [trashMonitors, setTrashMonitors] = useState<MonitorTask[]>([]);\r\n  const [trashLoading, setTrashLoading] = useState(false);\r\n\r\n  // 获取监控任务列表\r\n  const fetchMonitors = useCallback(async () => {\r\n    setLoading(true);\r\n    try {\r\n      const data = await monitorApi.getMonitors(userToken, on401);\r\n      setMonitors(data);\r\n    } catch (err) {\r\n      console.error('获取监控列表失败:', err);\r\n    } finally {\r\n      setLoading(false);\r\n      setRefreshing(false);\r\n    }\r\n  }, [userToken, on401]);\r\n\r\n  // 获取回收站列表\r\n  const fetchTrashMonitors = useCallback(async () => {\r\n    setTrashLoading(true);\r\n    try {\r\n      const data = await monitorApi.getTrash(userToken, on401);\r\n      setTrashMonitors(data);\r\n    } catch (err) {\r\n      console.error('获取回收站列表失败:', err);\r\n    } finally {\r\n      setTrashLoading(false);\r\n    }\r\n  }, [userToken, on401]);\r\n\r\n  // Phase 2: 创建监控任务（费用确认已在 CreateMonitorModal 中完成）\r\n  const createMonitor = useCallback(async (\r\n    params: MonitorCreatePayload,\r\n    searchDays: number,\r\n    onSuccess?: () => void\r\n  ): Promise<boolean> => {\r\n    try {\r\n      const requestPayload: MonitorCreatePayload = {\r\n        ...params,\r\n        // 保证搜索链路传来的真实天数不会在创建监控时丢失\r\n        days: params.days ?? searchDays,\r\n      };\r\n\r\n      // 直接调用 API 创建任务（后端会进行实际扣费和余额校验）\r\n      await monitorApi.createMonitor(userToken, requestPayload, on401);\r\n      await refreshUserInfo();\r\n      await fetchMonitors();\r\n      if (onSuccess) onSuccess();\r\n      return true;\r\n    } catch (err: unknown) {\r\n      const errMsg = err instanceof Error ? err.message : 'Unknown error';\r\n      // Phase 2: 检测余额不足错误\r\n      if (errMsg.includes('Insufficient credits') || errMsg.includes('402')) {\r\n        Alert.alert(\r\n          '💎 Insufficient Credits',\r\n          'You don\\'t have enough credits. Please top up first.',\r\n          [{ text: 'OK', style: 'cancel' }]\r\n        );\r\n      } else {\r\n        Alert.alert('Failed', errMsg);\r\n      }\r\n      return false;\r\n    }\r\n  }, [userToken, on401, refreshUserInfo, fetchMonitors]);\r\n\r\n  // 更新监控任务（含频率变更扣费后刷新积分）\r\n  const updateMonitor = useCallback(async (id: number, params: MonitorUpdatePayload) => {\r\n    try {\r\n      await monitorApi.updateMonitor(userToken, id, params, on401);\r\n      await fetchMonitors();\r\n      await refreshUserInfo();\r\n      return true;\r\n    } catch (err: unknown) {\r\n      const errMsg = err instanceof Error ? err.message : 'Unknown error';\n```\n","vector":[-0.05338339880108833,-0.002242448041215539,-0.0016280598938465118,0.02670881152153015,0.0014549641637131572,0.021512504667043686,0.07852057367563248,0.08474531024694443,0.03358114883303642,0.0070783477276563644,-0.009051871486008167,-0.0667482540011406,-0.003103683004155755,-0.008856162428855896,-0.023048367351293564,-0.0024998458102345467,-0.018327074125409126,-0.008171298541128635,-0.012607108801603317,-0.016359619796276093,0.03404885157942772,-0.06533407419919968,0.03299795463681221,-0.004726853687316179,0.00037863239413127303,0.011198116466403008,-0.0006757480441592634,-0.09322396665811539,-0.019119197502732277,0.02555626444518566,-0.02752060629427433,-0.0311295520