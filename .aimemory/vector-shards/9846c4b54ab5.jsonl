{"id":"9846c4b5_3","sourceFile":"frontend/components/admin/TimeRangePicker.tsx","type":"Source Code","content":"# Source: frontend/components/admin/TimeRangePicker.tsx\n# Lines: 1-42\n# Type: Source Code\n\n```typescript\nimport React from 'react';\r\nimport { View, TouchableOpacity, Text, StyleSheet } from 'react-native';\r\n\r\nconst RANGES = [\r\n  { key: 'day', label: 'Daily' },\r\n  { key: 'week', label: 'Weekly' },\r\n  { key: 'month', label: 'Monthly' },\r\n  { key: 'quarter', label: 'Quarterly' },\r\n];\r\n\r\ninterface Props {\r\n  value: string;\r\n  onChange: (range: string) => void;\r\n}\r\n\r\nexport const TimeRangePicker: React.FC<Props> = ({ value, onChange }) => (\r\n  <View style={s.row}>\r\n    {RANGES.map((r) => (\r\n      <TouchableOpacity\r\n        key={r.key}\r\n        style={[s.chip, value === r.key && s.chipActive]}\r\n        onPress={() => onChange(r.key)}\r\n      >\r\n        <Text style={[s.chipText, value === r.key && s.chipTextActive]}>\r\n          {r.label}\r\n        </Text>\r\n      </TouchableOpacity>\r\n    ))}\r\n  </View>\r\n);\r\n\r\nconst s = StyleSheet.create({\r\n  row: { flexDirection: 'row', gap: 6, marginBottom: 12, flexWrap: 'wrap' },\r\n  chip: {\r\n    paddingHorizontal: 14, paddingVertical: 7, borderRadius: 16,\r\n    backgroundColor: '#222', borderWidth: 1, borderColor: '#444',\r\n  },\r\n  chipActive: { backgroundColor: '#00FF00', borderColor: '#00FF00' },\r\n  chipText: { color: '#AAA', fontSize: 11, fontWeight: '600' },\r\n  chipTextActive: { color: '#000' },\r\n});\n```\n","vector":[-0.048007238656282425,0.03608744218945503,0.01696932688355446,0.09005755931138992,-0.02069890685379505,0.06802960485219955,0.04598844051361084,0.0457991324365139,0.06128431484103203,-0.04890625551342964,-0.05182407796382904,-0.06173408776521683,-0.050857312977313995,-0.00998934917151928,0.047071073204278946,0.025383392348885536,-0.06594232469797134,-0.05935564264655113,0.013146724551916122,-0.021437695249915123,0.036507219076156616