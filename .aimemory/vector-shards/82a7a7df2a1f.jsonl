{"id":"82a7a7df_2","sourceFile":"frontend/app/index.tsx","type":"Source Code","content":"# Source: frontend/app/index.tsx\n# Lines: 1-63\n# Type: Source Code\n\n```typescript\n// filename: app/index.tsx\r\nimport { useEffect } from 'react';\r\nimport { useRouter } from 'expo-router';\r\nimport { View, ActivityIndicator, StyleSheet, Text } from 'react-native';\r\nimport { useAuth } from '../hooks/useAuth';\r\n\r\nexport default function Index() {\r\n  const { isAuthenticated, loading } = useAuth();\r\n  const router = useRouter();\r\n\r\n  useEffect(() => {\r\n    if (loading) return;\r\n    \r\n    // 等待路由系统就绪后再跳转\r\n    const performNavigation = () => {\r\n      try {\r\n        if (isAuthenticated) {\r\n          router.replace('/(tabs)/search');\r\n        } else {\r\n          router.replace('/auth/login');\r\n        }\r\n      } catch (err) {\r\n        console.error('路由跳转失败:', err);\r\n        // 如果路由未就绪，延迟重试\r\n        setTimeout(performNavigation, 100);\r\n      }\r\n    };\r\n\r\n    // 使用 requestAnimationFrame 确保在下一帧执行，此时路由系统应该已初始化\r\n    requestAnimationFrame(performNavigation);\r\n  }, [isAuthenticated, loading, router]);\r\n\r\n  // 显示加载状态\r\n  return (\r\n    <View style={styles.container}>\r\n      <Text style={styles.logo}>SKYHUNTER</Text>\r\n      <ActivityIndicator size=\"large\" color=\"#00FF00\" style={{ marginTop: 20 }} />\r\n      <Text style={styles.loadingText}>INITIALIZING...</Text>\r\n    </View>\r\n  );\r\n}\r\n\r\nconst styles = StyleSheet.create({\r\n  container: {\r\n    flex: 1,\r\n    backgroundColor: '#000000',\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n  },\r\n  logo: {\r\n    color: '#00FF00',\r\n    fontSize: 32,\r\n    fontWeight: '700',\r\n    letterSpacing: 4,\r\n  },\r\n  loadingText: {\r\n    color: '#666666',\r\n    fontSize: 12,\r\n    marginTop: 12,\r\n    letterSpacing: 2,\r\n  },\r\n});\n```\n","vector":[-0.051121361553668976,0.05403127521276474,0.009396785870194435,0.040683239698410034,0.012766600