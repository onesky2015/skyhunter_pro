{"id":"f1e58486_2","sourceFile":"frontend/components/PassengerStepper.tsx","type":"Source Code","content":"# Source: frontend/components/PassengerStepper.tsx\n# Lines: 1-81\n# Type: Source Code\n\n```typescript\nimport React from 'react';\r\nimport { View, Text, TouchableOpacity, StyleSheet } from 'react-native';\r\n\r\ninterface PassengerStepperProps {\r\n  label: string;\r\n  value: number;\r\n  onChange: (val: number) => void;\r\n  min?: number;\r\n  max?: number;\r\n}\r\n\r\nexport const PassengerStepper: React.FC<PassengerStepperProps> = ({\r\n  label,\r\n  value,\r\n  onChange,\r\n  min = 0,\r\n  max = 9,\r\n}) => {\r\n  return (\r\n    <View style={styles.container}>\r\n      <Text style={styles.label}>{label}</Text>\r\n      <View style={styles.stepperRow}>\r\n        <TouchableOpacity\r\n          style={styles.stepperBtn}\r\n          onPress={() => onChange(Math.max(min, value - 1))}\r\n        >\r\n          <Text style={styles.stepperBtnText}>−</Text>\r\n        </TouchableOpacity>\r\n        <Text style={styles.stepperValue}>{value}</Text>\r\n        <TouchableOpacity\r\n          style={styles.stepperBtn}\r\n          onPress={() => onChange(Math.min(max, value + 1))}\r\n        >\r\n          <Text style={styles.stepperBtnText}>+</Text>\r\n        </TouchableOpacity>\r\n      </View>\r\n    </View>\r\n  );\r\n};\r\n\r\nconst styles = StyleSheet.create({\r\n  container: {\r\n    flex: 1,\r\n  },\r\n  label: {\r\n    color: '#00FF00',\r\n    fontSize: 10,\r\n    fontWeight: '600',\r\n    marginBottom: 4,\r\n    textTransform: 'uppercase',\r\n  },\r\n  stepperRow: {\r\n    flexDirection: 'row',\r\n    alignItems: 'center',\r\n    backgroundColor: '#222222',\r\n    borderRadius: 8,\r\n    borderWidth: 1,\r\n    borderColor: '#333333',\r\n  },\r\n  stepperBtn: {\r\n    width: 40,\r\n    height: 40,\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n    backgroundColor: '#333333',\r\n    borderRadius: 8,\r\n  },\r\n  stepperBtnText: {\r\n    color: '#00FF00',\r\n    fontSize: 18,\r\n    fontWeight: '700',\r\n  },\r\n  stepperValue: {\r\n    flex: 1,\r\n    textAlign: 'center',\r\n    color: '#FFFFFF',\r\n    fontSize: 16,\r\n    fontWeight: '700',\r\n  },\r\n});\n```\n","vector":[-0.030477050691843033,-0.020495884120464325,0.04317116364836693,0.07925663143396378,-0.005495894234627485,0.135328009724617,0.04197336733341217,0.09201834350824356,0.0641949325799942,-0.03081592172384262,-0.051605310291051865,0.002993578789755702,-0.033337123692035675,0.0009685248951427639,0.017155662178993225,0.012407883070409298,-0.023201534524559975,-0.09065205603837967,-0.045773833990097046,0.0153133450075984,0.03334208205342293,-0.04322865605354309,0.0757579654455185,0.018164996057748795,-0.027668246999382973,0.03911290690302849,0.007290556561201811,-0.014643984846770763,0.04248536005616188,-0.05205942317843437,-0.0713772103190422,0.06735900044441223,-0.015595623292028904,0.0004731578810606152,-0.07265109568834305,-0.01670307293534279,-0.0842420682311058,-0.030972708016633987,-0.02720528095960617,0.008136916905641556,-0.01776926778256893,-0.015301372855901718,0.032061975449323654,-0.06448564678430557,0.007781362626701593,-0.03217361122369766,-0.02942572347819805,-0.0001360667811241001,0.008502459153532982,0.05872751399874687,-0.02329827845096588,0.038155026733875275,0.03903583064675331,-0.0239991694688797,0.033600665628910065,0.019203590229153633,0.03125395625829697,-0.0011434473562985659,0.08408321440219879,0.00017250962264370173,0.0183123592287302,0.023494156077504158,0.04895567148923874,-0.06779574602842331,0.016260165721178055,0.02118515409529209,-0.020823834463953972,0.033359963446855545,0.00391369266435504,0.053612180054187775,0.0476892814040184,0.03455141931772232,0.12571066617965698,-0.006346814334392548,0.01438610628247261,-0.11852197349071503,-0.013004926964640617,0.053485654294490814,0.01552659273147583,0.011532273143529892,-0.03395615890622139,-0.09501392394304276,-0.022341793403029442,0.038018155843019485,0.05