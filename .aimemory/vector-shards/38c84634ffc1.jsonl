{"id":"38c84634_2","sourceFile":"frontend/components/TripTypeToggle.tsx","type":"Source Code","content":"# Source: frontend/components/TripTypeToggle.tsx\n# Lines: 1-62\n# Type: Source Code\n\n```typescript\nimport React from 'react';\r\nimport { View, Text, TouchableOpacity, StyleSheet } from 'react-native';\r\nimport { TripType } from '../types';\r\n\r\ninterface TripTypeToggleProps {\r\n  tripType: TripType;\r\n  onChange: (type: TripType) => void;\r\n  style?: object;\r\n}\r\n\r\nexport const TripTypeToggle: React.FC<TripTypeToggleProps> = ({ tripType, onChange, style }) => {\r\n  return (\r\n    <View style={[styles.modeToggle, style]}>\r\n      <TouchableOpacity\r\n        style={[styles.modeButton, tripType === 'one_way' && styles.modeButtonActive]}\r\n        onPress={() => onChange('one_way')}\r\n      >\r\n        <Text style={[styles.modeText, tripType === 'one_way' && styles.modeTextActive]}>\r\n          → One-way\r\n        </Text>\r\n      </TouchableOpacity>\r\n      <TouchableOpacity\r\n        style={[styles.modeButton, tripType === 'round_trip' && styles.modeButtonActive]}\r\n        onPress={() => onChange('round_trip')}\r\n      >\r\n        <Text style={[styles.modeText, tripType === 'round_trip' && styles.modeTextActive]}>\r\n          ⇄ Round-trip\r\n        </Text>\r\n      </TouchableOpacity>\r\n    </View>\r\n  );\r\n};\r\n\r\nconst styles = StyleSheet.create({\r\n  modeToggle: {\r\n    flexDirection: 'row',\r\n    marginBottom: 16,\r\n    gap: 8,\r\n  },\r\n  modeButton: {\r\n    flex: 1,\r\n    padding: 12,\r\n    borderRadius: 8,\r\n    backgroundColor: '#222222',\r\n    alignItems: 'center',\r\n    borderWidth: 1,\r\n    borderColor: '#333333',\r\n  },\r\n  modeButtonActive: {\r\n    backgroundColor: '#00FF00',\r\n    borderColor: '#00FF00',\r\n  },\r\n  modeText: {\r\n    color: '#666666',\r\n    fontSize: 12,\r\n    fontWeight: '600',\r\n  },\r\n  modeTextActive: {\r\n    color: '#000000',\r\n  },\r\n});\n```\n","vector":[-0.03005421