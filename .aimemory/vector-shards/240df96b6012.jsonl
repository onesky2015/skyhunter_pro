{"id":"240df96b_1","sourceFile":"frontend/components/HeatmapGrid.tsx","type":"Object: HeatmapGrid","content":"# Source: frontend/components/HeatmapGrid.tsx\n# Lines: 15-81\n# Type: Object: HeatmapGrid\n\n```typescript\nexport const HeatmapGrid: React.FC<HeatmapGridProps> = ({ cells, label, onCellPress, onCreateMonitor }) => {\r\n  const isWeb = Platform.OS === 'web';\r\n\r\n  const formatCellDate = (dateStr: string): string => {\r\n    // Web 端显示 MM-DD 格式\r\n    const parts = dateStr.split('-');\r\n    if (parts.length === 3) return `${parts[1]}-${parts[2]}`;\r\n    return getDayFromDate(dateStr);\r\n  };\r\n\r\n  const handleCellPress = (cell: HeatmapCell) => {\r\n    // Phase 2: 优先触发创建监控流程\r\n    if (onCreateMonitor) {\r\n      onCreateMonitor(cell.date, cell.price);\r\n      return;\r\n    }\r\n\r\n    if (onCellPress) {\r\n      onCellPress(cell.date, cell.price);\r\n      return;\r\n    }\r\n    // 无回调时不做任何操作\r\n  };\r\n\r\n  if (cells.length === 0) {\r\n    return (\r\n      <View style={styles.placeholder}>\r\n        <Text style={styles.placeholderText}>No data</Text>\r\n      </View>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <View>\r\n      {label && <Text style={styles.label}>{label}</Text>}\r\n      <View style={isWeb ? styles.gridWeb : styles.grid}>\r\n        {cells.map((cell) => (\r\n          <TouchableOpacity\r\n            key={cell.date}\r\n            style={[\r\n              isWeb ? styles.cellWeb : styles.cell,\r\n              { backgroundColor: getLevelColor(cell.level), opacity: getLevelOpacity(cell.level) },\r\n            ]}\r\n            activeOpacity={0.7}\r\n            onPress={() => handleCellPress(cell)}\r\n          >\r\n            {isWeb ? (\r\n              <>\r\n                <Text style={styles.cellDateWeb}>{formatCellDate(cell.date)}</Text>\r\n                <Text style={styles.cellPriceWeb}>\r\n                  {cell.price != null ? `$${Math.round(cell.price)}` : '---'}\r\n                </Text>\r\n              </>\r\n            ) : (\r\n              <>\r\n                <Text style={styles.cellDay}>{getDayFromDate(cell.date)}</Text>\r\n                {cell.price != null && (\r\n                  <Text style={styles.cellPrice}>${Math.round(cell.price)}</Text>\r\n                )}\r\n              </>\r\n            )}\r\n          </TouchableOpacity>\r\n        ))}\r\n      </View>\r\n    </View>\r\n  );\r\n};\n```\n","vector":[-0.043182432651519775,0.09282563626766205,0.06560469418764114,0.11027500778436661,-0.0012096613645553589,0.07531089335680008,0.006788930390030146,0.03137928247451782,0.057749390602111816,-0.009973574429750443,-0.044510580599308014,-0.05720868334174156,-0.05949012562632561,-0.038827382028102875,0.04802975058555603,-0.021955374628305435,-0.024813152849674225,-0.04816924035549164,-0.05545955151319504,-0.06439650058746338,0.060470081865787506,-0.07830203324556351,0.05530242621898651,-0.04290398955345154,0.03890074044466019,0.07934427261352539,0.04375142231583595,0.024503745138645172,-0.02305670827627182,0.005969990976154804,-0.021015051752328873,0.0569007433950901,-0.0843859389424324,0.03715852275490761,-0.032705530524253845,0.009204745292663574,-0.06106346473097801,0.0027404758147895336,0.020337458699941635,-0.003996202256530523,0.001362958806566894,0.04043643921613693,0.020892104133963585,-0.04649141803383827,-0.005531699862331152,-0.029979201033711433,-0.03195694833993912,-0.02819276973605156,-0.025177644565701485,0.0461505763232708,-0.04903709143400192,-0.009451441466808319,0.024400455877184868,-0.003085019998252392,0.05241517350077629,0.09285476803779602,0.006242713890969753,-0.06917981058359146,0.10382925719022751,0.008843633346259594,-0.009411652572453022,0.0004018720064777881,0.005820204503834248,-0.06092293933033943,0.013530204072594643,-0.04219207167625427,0.034850798547267914,0.01517812255769968,-0.015322445891797543,0.030770789831876755,0.030012374743819237,0.030558694154024124,0.11525899171829224,-0.023669060319662094,0.007135059218853712,-0.