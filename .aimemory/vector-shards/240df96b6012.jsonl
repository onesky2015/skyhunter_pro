{"id":"240df96b_3","sourceFile":"frontend/components/HeatmapGrid.tsx","type":"Source Code","content":"# Source: frontend/components/HeatmapGrid.tsx\n# Lines: 1-104\n# Type: Source Code\n\n```typescript\n// filename: components/HeatmapGrid.tsx\r\nimport React from 'react';\r\nimport { View, Text, TouchableOpacity, StyleSheet, Platform } from 'react-native';\r\nimport { HeatmapCell } from '../types';\r\nimport { getLevelColor, getLevelOpacity, getDayFromDate } from '../constants/utils';\r\n\r\ninterface HeatmapGridProps {\r\n  cells: HeatmapCell[];\r\n  label?: string;\r\n  onCellPress?: (date: string, price: number | null) => void;\r\n  /** Phase 2: 点击后直接触发创建监控（优先于 onCellPress） */\r\n  onCreateMonitor?: (date: string, price: number | null) => void;\r\n}\r\n\r\nexport const HeatmapGrid: React.FC<HeatmapGridProps> = ({ cells, label, onCellPress, onCreateMonitor }) => {\r\n  const isWeb = Platform.OS === 'web';\r\n\r\n  const formatCellDate = (dateStr: string): string => {\r\n    // Web 端显示 MM-DD 格式\r\n    const parts = dateStr.split('-');\r\n    if (parts.length === 3) return `${parts[1]}-${parts[2]}`;\r\n    return getDayFromDate(dateStr);\r\n  };\r\n\r\n  const handleCellPress = (cell: HeatmapCell) => {\r\n    // Phase 2: 优先触发创建监控流程\r\n    if (onCreateMonitor) {\r\n      onCreateMonitor(cell.date, cell.price);\r\n      return;\r\n    }\r\n\r\n    if (onCellPress) {\r\n      onCellPress(cell.date, cell.price);\r\n      return;\r\n    }\r\n    // 无回调时不做任何操作\r\n  };\r\n\r\n  if (cells.length === 0) {\r\n    return (\r\n      <View style={styles.placeholder}>\r\n        <Text style={styles.placeholderText}>No data</Text>\r\n      </View>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <View>\r\n      {label && <Text style={styles.label}>{label}</Text>}\r\n      <View style={isWeb ? styles.gridWeb : styles.grid}>\r\n        {cells.map((cell) => (\r\n          <TouchableOpacity\r\n            key={cell.date}\r\n            style={[\r\n              isWeb ? styles.cellWeb : styles.cell,\r\n              { backgroundColor: getLevelColor(cell.level), opacity: getLevelOpacity(cell.level) },\r\n            ]}\r\n            activeOpacity={0.7}\r\n            onPress={() => handleCellPress(cell)}\r\n          >\r\n            {isWeb ? (\r\n              <>\r\n                <Text style={styles.cellDateWeb}>{formatCellDate(cell.date)}</Text>\r\n                <Text style={styles.cellPriceWeb}>\r\n                  {cell.price != null ? `$${Math.round(cell.price)}` : '---'}\r\n                </Text>\r\n              </>\r\n            ) : (\r\n              <>\r\n                <Text style={styles.cellDay}>{getDayFromDate(cell.date)}</Text>\r\n                {cell.price != null && (\r\n                  <Text style={styles.cellPrice}>${Math.round(cell.price)}</Text>\r\n                )}\r\n              </>\r\n            )}\r\n          </TouchableOpacity>\r\n        ))}\r\n      </View>\r\n    </View>\r\n  );\r\n};\r\n\r\nconst styles = StyleSheet.create({\r\n  placeholder: {\r\n    padding: 20,\r\n    alignItems: 'center',\r\n  },\r\n  placeholderText: {\r\n    color: '#666666',\r\n    fontSize: 14,\r\n  },\r\n  label: {\r\n    color: '#00FF00',\r\n    fontSize: 12,\r\n    fontWeight: '600',\r\n    marginBottom: 8,\r\n    textTransform: 'uppercase',\r\n  },\r\n  grid: {\r\n    flexDirection: 'row',\r\n    flexWrap: 'wrap',\r\n    gap: 4,\r\n  },\n```\n","vector":[-0.04650812968611717,0.09078715741634369,0.0784418135881424,0.09217746555805206,-0.011216136626899242,0.07085847109556198,0.007996360771358013,0.05746698006987572,0.044094718992710114,-0.03181583434343338,-0.020360643044114113,-0.07967273890972137,-0.029260927811264992,-0.06214410811662674,0.06066310778260231,-0.0180161502212286,-0.04202866181731224,-0.04133113846182823,-0.04801180958747864,-0.04274795204401016,0.03812435269355774,-0.05348760262131691,0.04545814171433449,-0.03147008270025253,0.049086421728134155,0.10502778738737106,0.06664852797985077,-0.008153736591339111,-0.041