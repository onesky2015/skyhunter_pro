@app.get("/api/v1/track/{monitor_id}", tags=["track"], summary="预订链接追踪重定向")
async def track_booking_click(monitor_id: int):
    """
    记录预订链接点击并重定向到 Google Flights / 航司官网。
    邮件中的「立即查看详情」应使用此链接，便于统计点击转化。
    """
    with Session(engine) as session:
        task = session.get(MonitorTask, monitor_id)
        if not task:
            return RedirectResponse(url="https://www.google.com/flights", status_code=302)
        if not task.booking_link or task.booking_link == "#":
            return RedirectResponse(url="https://www.google.com/flights", status_code=302)
        task.click_count = (task.click_count or 0) + 1
        task.last_clicked_at = datetime.utcnow().isoformat()
        session.add(task)
        session.commit()
        logger.info(f"📊 监控 #{monitor_id} 预订链接点击 +1，累计 {task.click_count}")
        return RedirectResponse(url=task.booking_link, status_code=302)


