# 通知服务
# ============================================================================


def _send_email_core(to_email: str, subject: str, html_content: str, sender_name: str = "SkyHunter Bot") -> bool:
    """
    核心邮件发送函数：根据 EMAIL_PROVIDER 切换 SMTP / Brevo 双通道。

    Args:
        to_email: 收件人邮箱
        subject: 邮件主题
        html_content: HTML 邮件正文
        sender_name: 发件人显示名称

    Returns:
        是否发送成功
    """
    if not to_email:
        logger.warning("📧 收件人邮箱为空，跳过发送")
        return False

    if EMAIL_PROVIDER == "brevo":
        # ── Brevo HTTP API 通道 ──
        import requests as _requests
        if not BREVO_API_KEY:
            logger.warning("📧 BREVO_API_KEY 未配置，跳过邮件通知")
            return False
        payload = {
            "sender": {"name": sender_name, "email": EMAIL_SENDER},
            "to": [{"email": to_email}],
            "subject": subject,
            "htmlContent": html_content,
        }
        try:
            resp = _requests.post(
                "https://api.brevo.com/v3/smtp/email", json=payload,
                headers={"accept": "application/json", "api-key": BREVO_API_KEY, "content-type": "application/json"},
                timeout=10,
            )
            if resp.status_code == 201:
                logger.info(f"📧 [Brevo] 邮件已发送至 {to_email}")
                return True
            else:
                logger.error(f"📧 [Brevo] 发送失败: HTTP {resp.status_code} - {resp.text}")
                return False
        except Exception as e:
            logger.error(f"❌ [Brevo] 邮件网络错误: {e}")
            return False
    else:
        # ── 原生 SMTP 通道（默认，适用于 QQ 邮箱等免费邮箱） ──
        if not EMAIL_PASSWORD:
            logger.warning("📧 EMAIL_PASSWORD 未配置，跳过 SMTP 邮件发送")
            return False
        msg = MIMEMultipart("alternative")
        msg["From"] = f"{sender_name} <{EMAIL_SENDER}>"
        msg["To"] = to_email
        msg["Subject"] = subject
        msg.attach(MIMEText(html_content, "html", "utf-8"))
        try:
            with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, timeout=15) as server:
                server.login(EMAIL_SENDER, EMAIL_PASSWORD)
                server.sendmail(EMAIL_SENDER, [to_email], msg.as_string())
            logger.info(f"📧 [SMTP] 邮件已发送至 {to_email} (via {SMTP_HOST})")
            return True
        except smtplib.SMTPAuthenticationError as e:
            logger.error(f"❌ [SMTP] 认证失败（请检查 EMAIL_SENDER / EMAIL_PASSWORD）: {e}")
            return False
        except smtplib.SMTPException as e:
            logger.error(f"❌ [SMTP] 发送异常: {e}")
            return False
        except Exception as e:
            logger.error(f"❌ [SMTP] 网络错误: {e}")
            return False


def send_alert_email(
    to_email: str, origin: str, destination: str, price: float,
    target_price: float, departure_date: str, link: str = "#",
    adults: int = 1, children: int = 0,
    airline: Optional[str] = None, flight_number: Optional[str] = None,
    monitor_id: Optional[int] = None,
) -> bool:
    """
    发送降价提醒邮件（支持多人价格与航司信息，通过 _send_email_core 统一派发）
    若 API_BASE_URL 已配置且传入 monitor_id，邮件中的链接将使用追踪 URL 以统计点击。
    """
    if not to_email:
        return False
    # 优先使用追踪链接（便于统计点击转化）
    final_link = link
    if API_BASE_URL and monitor_id and link and link != "#":
        final_link = f"{API_BASE_URL}/api/v1/track/{monitor_id}"
    total_pax = adults + children
    per_person = (price / total_pax) if total_pax > 0 else price
    target_per_person = (target_price / total_pax) if total_pax > 0 else target_price
    savings = target_price - price
    savings_pct = (savings / target_price) * 100 if target_price > 0 else 0
    savings_per_person = target_per_person - per_person
    total_savings = savings  # 共省

    # 多人时显示「全程总价 (X成人)」「人均」「目标人均」「人均节省」「共省」
    if total_pax > 1:
        price_label = f"全程总价 ({adults}成人)"
        if children > 0:
            price_label = f"全程总价 ({adults}成人{children}童)"
        price_line = f"<div style=\"font-size: 14px; color: #558B2F;\">{price_label}</div><div style=\"font-size: 56px; color: #00C853; font-weight: 800; margin: 10px 0;\">${price:.2f}</div><div style=\"color: #90A4AE; font-size: 14px;\">您的目标人均价: ${target_per_person:.2f}</div><div style=\"font-size: 13px; color: #558B2F; margin-top: 8px;\">{adults}成人 | 人均 ${per_person:.2f} | 目标人均 ${target_per_person:.2f}</div>"
        savings_line = f"<div style=\"background: #00C853; color: white; padding: 8px 16px; border-radius: 8px; font-size: 14px; font-weight: bold; margin-top: 12px;\">🔥 人均节省 ${savings_per_person:.2f}, 共省 ${total_savings:.2f} ({savings_pct:.0f}%)</div>" if savings > 0 else ""
    else:
        price_line = f"<div style=\"font-size: 12px; color: #558B2F; font-weight: bold;\">CURRENT LOWEST PRICE</div><div style=\"font-size: 56px; color: #00C853; font-weight: 800; margin: 10px 0;\">${price:.2f}</div><div style=\"color: #90A4AE; font-size: 14px; text-decoration: line-through;\">Your target: ${target_price:.2f}</div>"
        savings_line = f"<div style='background: #00C853; color: white; padding: 6px 16px; border-radius: 50px; font-size: 14px; font-weight: bold; display: inline-block; margin-top: 10px;'>🔥 Save ${savings:.2f} ({savings_pct:.0f}%)</div>" if savings > 0 else ""

    airline_block = ""
    if airline or flight_number:
        airline_block = f"<div style=\"background: #E3F2FD; padding: 8px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px;\">✈️ 承运航司: {airline or '—'} {(' · ' + flight_number) if flight_number else ''}</div>"

    html_content = f"""
    <html><body style="font-family: -apple-system, sans-serif; background-color: #f4f7f6; margin: 0; padding: 0;">
    <div style="max-width: 600px; margin: 30px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.08);">
        <div style="background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%); color: #fff; padding: 30px 20px; text-align: center;">
            <h1 style="margin: 0; font-size: 24px;">✈️ 航班降价提醒</h1>
            <p style="margin-top: 10px; opacity: 0.9;">SkyHunter 为您发现符合预算的航班</p>
        </div>
        <div style="padding: 40px 30px; text-align: center;">
            <div style="font-size: 24px; font-weight: bold; color: #37474F; margin-bottom: 20px;">{origin} ➝ {destination}</div>
            <div style="background: #ECEFF1; padding: 8px 20px; border-radius: 8px; display: inline-block; margin-bottom: 20px;">📅 出发日期: {departure_date}</div>
            {airline_block}
            <div style="background: #F1F8E9; border: 2px solid #00C853; border-radius: 12px; padding: 25px; margin-bottom: 30px;">
                {price_line}
                {savings_line}
            </div>
            <p style="font-size: 13px; color: #546E7A; margin-bottom: 20px;">SkyHunter 已为您监控到符合预算的机票，价格随时可能变动，建议尽快确认。</p>
            <a href="{final_link}" style="background: #1E88E5; color: #fff; text-decoration: none; padding: 16px 45px; border-radius: 50px; font-weight: bold; font-size: 18px; display: inline-block;">立即查看详情 →</a>
            <p style="font-size: 12px; color: #90A4AE; margin-top: 20px;">请自行前往 Google Flights 或航司官网完成购买。本通知仅提示价格变化，SkyHunter 不参与任何购票交易。</p>
        </div>
        <div style="background: #CFD8DC; padding: 15px; text-align: center; color: #546E7A; font-size: 12px;">SkyHunter 自动监控服务，如需退订请回复本邮件</div>
    </div></body></html>
    """
    subject = f"✈️ 航班降价提醒 {origin} → {destination} 现价 ${price:.2f}"
    return _send_email_core(to_email, subject, html_content, sender_name="SkyHunter Bot")


def send_reset_code_email(to_email: str, code: str) -> bool:
    """
    发送密码重置验证码邮件（通过 _send_email_core 统一派发）

    Args:
        to_email: 收件人邮箱
        code: 6位数字验证码

    Returns:
