    </div></body></html>
    """
    subject = f"🔐 SkyHunter Password Reset Code: {code}"
    return _send_email_core(to_email, subject, html_content, sender_name="SkyHunter Security")


# ============================================================================
# 后台调度器
# ============================================================================

_scheduler = None


def _parse_iso_datetime(value):
    """
    兼容 SQLModel / PostgreSQL 可能返回 datetime 或 ISO 字符串两种形式。
    """
    if not value:
        return None
    if isinstance(value, datetime):
        return value
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value)
        except ValueError:
            return None
    return None


def _parse_iso_date(value):
    """
    兼容 SQLModel / PostgreSQL 可能返回 date / datetime / ISO 字符串三种形式。
    """
    if not value:
        return None
    if isinstance(value, date) and not isinstance(value, datetime):
        return value
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, str):
        try:
            return date.fromisoformat(value)
        except ValueError:
            return None
    return None


def _stringify_temporal_value(value):
    """统一将 date/datetime 转成 ISO 字符串，避免响应序列化告警。"""
    if value is None:
        return None
    if isinstance(value, datetime):
        return value.isoformat()
    if isinstance(value, date):
        return value.isoformat()
    return value


def _monitor_response_from_task(task: MonitorTask) -> MonitorResponse:
    """将数据库任务对象安全映射为 API 响应。"""
    payload = task.model_dump()
    for field_name in ("start_date", "return_date", "last_checked_at", "created_at", "end_date", "next_run_time"):
        payload[field_name] = _stringify_temporal_value(payload.get(field_name))
    return MonitorResponse(**payload)


def _process_active_monitors():
    """
    Phase 2: Per-Task 独立调度心跳（每 5 分钟执行一次）

    逻辑：
    1. 查询所有 active + 未删除的任务
    2. 对每个任务检查 end_date → 过期则标记 expired
    3. 检查 next_run_time → 未到时间则跳过
    4. 执行价格检查 → 更新 next_run_time
    """
    now = datetime.utcnow()
    now_iso = now.isoformat()
    logger.info(f"\n💓 [Scheduler] 心跳 {now.strftime('%H:%M:%S')} UTC (5min per-task)")
    executed_count = 0
    try:
        with Session(engine) as session:
            statement = select(MonitorTask).where(
                MonitorTask.status == "active",
                MonitorTask.is_deleted == False,
            )
            tasks = session.exec(statement).all()
            if not tasks:
                logger.info("  ℹ️ 无活跃任务")
                return
            logger.info(f"  📋 发现 {len(tasks)} 个活跃任务，开始逐个检查...")

            for task in tasks:
                try:
                    # ── Step 1: 检查 end_date 过期 ──
                    if task.end_date:
                        end_dt = _parse_iso_datetime(task.end_date)
                        if end_dt and now > end_dt:
                            task.status = "expired"
                            session.add(task)
                            session.commit()
                            logger.info(f"  ⏰ 任务 #{task.id} 已过期 (end_date={task.end_date})")
                            continue
                    else:
                        # 兼容旧任务（无 end_date）：用 start_date + days 判断
                        task_start = _parse_iso_date(task.start_date)
                        if task_start:
                            task_end = task_start + timedelta(days=task.days)
                            if date.today() > task_end:
                                task.status = "expired"
                                session.add(task)
                                session.commit()
                                logger.info(f"  ⏰ 任务 #{task.id} 已过期 (legacy: start+days)")
                                continue

                    # ── Step 2: 检查 next_run_time（是否到达执行时间）──
                    if task.next_run_time:
                        next_run = _parse_iso_datetime(task.next_run_time)
                        if next_run and now < next_run:
                            continue  # 未到执行时间，跳过

                    # ── Step 3: 执行价格检查 ──
                    logger.info(f"  ✈️ 执行任务 #{task.id}: {task.origin}->{task.destination} (间隔={task.interval_minutes}m)")
                    executed_count += 1

                    check_date = _parse_iso_date(task.start_date) or (date.today() + timedelta(days=1))

                    return_date_obj = None
                    if task.trip_type == "round_trip" and task.return_date:
                        return_date_obj = _parse_iso_date(task.return_date)

                    if USE_MOCK_DATA:
                        mock_data = _generate_mock_heatmap(task.origin, task.destination, check_date, 1, task.cabin_class)
                        if mock_data and mock_data[0]["price"] is not None:
                            current_price = mock_data[0]["price"]
                            if return_date_obj:
                                return_mock = _generate_mock_heatmap(task.destination, task.origin, return_date_obj, 1, task.cabin_class)
                                if return_mock and return_mock[0]["price"] is not None:
                                    current_price += return_mock[0]["price"]
                            mock_flight = _generate_mock_flight_detail(
                                task.origin, task.destination, task.start_date, current_price,
                                max_stops=task.max_stops, departure_time_min=task.departure_time_min,
                                departure_time_max=task.departure_time_max, arrival_time_min=task.arrival_time_min,
                                arrival_time_max=task.arrival_time_max, airline_include=task.airline_include,
                            )
                            flight_info = mock_flight.model_dump()
                        else:
                            current_price = None
                            flight_info = None
                    else:
                        result = _search_serpapi_single_day(
                            task.origin, task.destination, check_date, task.cabin_class,
                            task.adults, task.children, task.max_stops,
                            task.departure_time_min, task.departure_time_max,
                            task.sort_strategy or "best", task.arrival_time_min,
                            task.arrival_time_max, task.airline_include, task.excluded_airlines,
                            return_date_obj,
                        )
                        if result:
                            current_price = result["price"]
                            flight_info = result
                        else:
                            current_price = None
                            flight_info = None

                    task.last_checked_at = now_iso
                    if current_price is not None:
                        task.current_price = current_price
                        if task.lowest_price is None or current_price < task.lowest_price:
                            task.lowest_price = current_price
                            task.lowest_price_date = check_date.isoformat()
                            if flight_info:
                                task.booking_link = flight_info.get("booking_link")
                                task.airline = flight_info.get("airline")
                                task.flight_number = flight_info.get("flight_number")
                                task.baggage_info = flight_info.get("baggage_info")
                        ph = PriceHistory(
                            monitor_id=task.id, price=current_price, checked_at=now_iso,
                            booking_link=flight_info.get("booking_link") if flight_info else None,
                        )
                        session.add(ph)
                        if task.target_price and current_price <= task.target_price:
                            task.status = "found"
                            if task.notification_email:
                                send_alert_email(
                                    to_email=task.notification_email, origin=task.origin,
                                    destination=task.destination, price=current_price,
                                    target_price=task.target_price, departure_date=task.start_date,
                                    link=task.booking_link or "#",
                                    adults=task.adults, children=task.children,
                                    airline=flight_info.get("airline") if flight_info else None,
                                    flight_number=flight_info.get("flight_number") if flight_info else None,
                                    monitor_id=task.id,
                                )

                    # ── Step 4: 更新 next_run_time ──
                    interval = task.interval_minutes or 240
                    task.next_run_time = (now + timedelta(minutes=interval)).isoformat()

                    session.add(task)
                    session.commit()

                    if not USE_MOCK_DATA:
                        _time_module.sleep(2)

                except Exception as e:
                    logger.error(f"    ❌ 任务 #{task.id} 异常: {e}")
                    continue

        logger.info(f"  ✅ 心跳完成: 执行了 {executed_count} 个任务")
    except Exception as e:
        logger.error(f"❌ 调度器致命错误: {e}")
        import traceback
        traceback.print_exc()


# Phase 2: 调度器心跳间隔从 SCHEDULER_INTERVAL_HOURS 改为 5 分钟
SCHEDULER_HEARTBEAT_MINUTES: int = 5


def start_scheduler():
    global _scheduler
    try:
        from apscheduler.schedulers.background import BackgroundScheduler
    except ImportError:
        logger.error("❌ apscheduler 未安装")
        return
    if _scheduler is not None:
        return
    _scheduler = BackgroundScheduler()
    _scheduler.add_job(
        func=_process_active_monitors, trigger="interval",
        minutes=SCHEDULER_HEARTBEAT_MINUTES, id="process_monitors",
        name=f"每{SCHEDULER_HEARTBEAT_MINUTES}分钟心跳 (per-task 独立调度)",
        replace_existing=True, max_instances=1, misfire_grace_time=600,
    )
    _scheduler.start()
    logger.info(f"⏰ Phase 2 调度器已启动: 每 {SCHEDULER_HEARTBEAT_MINUTES} 分钟心跳，per-task 独立频率")
    logger.info("🔍 启动后立即执行首次检查...")
    _process_active_monitors()


def stop_scheduler():
    global _scheduler
    if _scheduler is not None:
        _scheduler.shutdown()
        _scheduler = None
        logger.info("🛑 调度器已停止")


# ============================================================================
# FastAPI 应用实例
# ============================================================================


@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.info("=" * 60)
    logger.info(f"🚀 SkyHunter Pro API v{APP_VERSION} Starting...")
    logger.info(f"   Mock Mode: {'ON' if USE_MOCK_DATA else 'OFF'}")
    logger.info(f"   Auth: JWT (HS256, {JWT_EXPIRE_HOURS}h expiry)")
    logger.info(f"   Email: {EMAIL_PROVIDER.upper()} ({'Brevo API' if EMAIL_PROVIDER == 'brevo' else SMTP_HOST + ':' + str(SMTP_PORT)})")
    logger.info(f"   Scheduler: Every {SCHEDULER_HEARTBEAT_MINUTES} minutes heartbeat (per-task)")
    logger.info(f"   Database: {'SQLite (' + DATABASE_FILE + ')' if _is_sqlite else 'PostgreSQL (Supabase)'}")
    logger.info(f"   DB Mode: {DB_MODE.upper()}")
    logger.info("=" * 60)

    # ── 数据库初始化 ──
    if _is_sqlite:
        # SQLite: create_all 创建新表 + 手动 ALTER TABLE 添加缺失列
        try:
            SQLModel.metadata.create_all(engine)
            logger.info("✅ SQLite 数据库表已创建/确认")
        except Exception as create_err:
            # 已有数据库中索引可能已存在，忽略 "index already exists"
            if "already exists" not in str(create_err).lower():
                raise
            logger.warning(f"⚠️ create_all 跳过（索引已存在）: {create_err}")
            logger.info("✅ SQLite 数据库表已就绪")

        # SQLite 迁移：自动添加缺失列（SQLite 不支持 ADD COLUMN IF NOT EXISTS，需先检查）
        from sqlalchemy import inspect as sa_inspect, text as sa_text
        try:
            with engine.begin() as conn:
                inspector = sa_inspect(conn)
                for table in SQLModel.metadata.sorted_tables:
                    try:
                        existing_columns = {col["name"] for col in inspector.get_columns(table.name)}
                    except Exception:
                        # 表不存在（create_all 应已处理），跳过
                        continue

                    for column in table.columns:
                        if column.name not in existing_columns:
                            col_type = column.type.compile(dialect=engine.dialect)
                            default_clause = ""
                            if column.default is not None and hasattr(column.default, "arg"):
                                default_val = column.default.arg
                                if not callable(default_val):
                                    if isinstance(default_val, bool):
                                        default_clause = f" DEFAULT {1 if default_val else 0}"
                                    elif isinstance(default_val, (int, float)):
                                        default_clause = f" DEFAULT {default_val}"
                                    elif isinstance(default_val, str):
                                        safe_val = default_val.replace("'", "''")
                                        default_clause = f" DEFAULT '{safe_val}'"
                            elif column.nullable:
                                default_clause = " DEFAULT NULL"
                            alter_sql = f'ALTER TABLE "{table.name}" ADD COLUMN "{column.name}" {col_type}{default_clause}'
                            try:
                                conn.execute(sa_text(alter_sql))
                                logger.info(f"  ✅ SQLite 迁移: 添加列 {table.name}.{column.name} ({col_type})")
                            except Exception as col_err:
                                # SQLite 列已存在时会报 "duplicate column name"，安全忽略
                                if "duplicate column" not in str(col_err).lower():
                                    logger.warning(f"  ⚠️ SQLite 迁移失败 {table.name}.{column.name}: {col_err}")
            logger.info("✅ SQLite 数据库迁移完成")
        except Exception as migrate_err:
            logger.error(f"❌ SQLite 迁移异常: {migrate_err}")
            import traceback
            traceback.print_exc()
    else:
        # PostgreSQL: 兼容已有表，自动添加缺失列和索引
        from sqlalchemy import inspect as sa_inspect, text as sa_text
        from sqlalchemy.schema import CreateTable

        try:
            with engine.begin() as conn:
                inspector = sa_inspect(conn)

                for table in SQLModel.metadata.sorted_tables:
                    # Step 1: CREATE TABLE IF NOT EXISTS
                    try:
                        create_ddl = CreateTable(table).compile(dialect=engine.dialect)
                        create_sql = str(create_ddl).replace("CREATE TABLE", "CREATE TABLE IF NOT EXISTS", 1)
                        conn.execute(sa_text(create_sql))
                        logger.info(f"  ✅ 表 {table.name} 已就绪")
                    except Exception as tbl_err:
                        logger.warning(f"  ⚠️ 创建表 {table.name} 异常（可能已存在）: {tbl_err}")

                    # Step 2: ALTER TABLE ADD COLUMN IF NOT EXISTS
                    try:
                        existing_columns = {col["name"] for col in inspector.get_columns(table.name)}
                    except Exception:
                        existing_columns = set()

                    for column in table.columns:
                        if column.name not in existing_columns and existing_columns:
                            col_type = column.type.compile(dialect=engine.dialect)
                            default_clause = ""
                            if column.default is not None and hasattr(column.default, "arg"):
                                default_val = column.default.arg
                                if not callable(default_val):
                                    if isinstance(default_val, bool):
                                        default_clause = f" DEFAULT {'TRUE' if default_val else 'FALSE'}"
                                    elif isinstance(default_val, (int, float)):
                                        default_clause = f" DEFAULT {default_val}"
                                    elif isinstance(default_val, str):
                                        safe_val = default_val.replace("'", "''")
                                        default_clause = f" DEFAULT '{safe_val}'"
                            elif column.nullable:
                                default_clause = " DEFAULT NULL"
                            alter_sql = f'ALTER TABLE "{table.name}" ADD COLUMN IF NOT EXISTS "{column.name}" {col_type}{default_clause}'
                            try:
                                conn.execute(sa_text(alter_sql))
                                logger.info(f"  ✅ 添加列: {table.name}.{column.name} ({col_type})")
                            except Exception as col_err:
                                logger.warning(f"  ⚠️ 添加列失败 {table.name}.{column.name}: {col_err}")

                    # Step 3: CREATE INDEX IF NOT EXISTS
                    for index in table.indexes:
                        if index.name:
                            idx_cols = ", ".join(f'"{c.name}"' for c in index.columns)
                            unique_kw = "UNIQUE " if index.unique else ""
                            create_idx_sql = f'CREATE {unique_kw}INDEX IF NOT EXISTS "{index.name}" ON "{table.name}" ({idx_cols})'
                            try:
                                conn.execute(sa_text(create_idx_sql))
                            except Exception:
                                pass

            logger.info("✅ PostgreSQL 数据库表已初始化")

        except Exception as db_init_err:
            logger.error(f"❌ 数据库初始化失败: {db_init_err}")
            import traceback
            traceback.print_exc()
            raise

    start_scheduler()
    yield
    stop_scheduler()
    logger.info("🛑 SkyHunter Pro API Stopped")


app = FastAPI(
    title="SkyHunter Pro API",
    description=APP_DESCRIPTION,
    version=APP_VERSION,
    docs_url="/docs",
    redoc_url="/redoc",
    lifespan=lifespan,
)

# Sentry 异常追踪（可选，生产环境配置 SENTRY_DSN 后自动启用）
SENTRY_DSN: str = os.getenv("SENTRY_DSN", "").strip()
if SENTRY_DSN:
    try:
        import sentry_sdk
        from sentry_sdk.integrations.fastapi import FastApiIntegration
        sentry_sdk.init(
            dsn=SENTRY_DSN,
            integrations=[FastApiIntegration()],
            traces_sample_rate=0.1,
            environment="production" if not USE_MOCK_DATA else "development",
        )
        logger.info("📡 Sentry 异常追踪已启用")
    except Exception as e:
        logger.warning(f"⚠️ Sentry 初始化失败: {e}")

app.add_middleware(
    CORSMiddleware,
    allow_origins=CORS_ALLOWED_ORIGINS,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
    expose_headers=["*"],
)


# ============================================================================
# 全局异常处理：确保 401/403 等错误响应也带 CORS 头
# ============================================================================

@app.exception_handler(HTTPException)
async def cors_http_exception_handler(request: StarletteRequest, exc: HTTPException):
    """
    自定义 HTTPException 处理器：确保所有错误响应（尤其是 401）
    都包含正确的 CORS 头，防止浏览器因 CORS 策略阻止前端读取 401 状态。
    """
    headers = {}
    origin = request.headers.get("origin", "")
    if origin:
        if "*" in CORS_ALLOWED_ORIGINS or origin in CORS_ALLOWED_ORIGINS:
            headers["Access-Control-Allow-Origin"] = origin if "*" not in CORS_ALLOWED_ORIGINS else "*"
            headers["Access-Control-Allow-Credentials"] = "true"
            headers["Access-Control-Allow-Methods"] = "*"
            headers["Access-Control-Allow-Headers"] = "*"
    return JSONResponse(
        status_code=exc.status_code,
        content={"detail": exc.detail},
        headers=headers,
    )


