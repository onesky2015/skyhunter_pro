      "fields": {
        "id": { "type": "int", "primary_key": true, "auto_increment": true },
        "email": { "type": "str", "unique": true, "index": true, "description": "邮箱（唯一，用于登录）" },
        "phone": { "type": "str", "unique": true, "nullable": true, "description": "手机号（唯一，可选）" },
        "hashed_password": { "type": "str", "description": "bcrypt 哈希密码" },
        "full_name": { "type": "str", "nullable": true, "description": "用户全名" },
        "role": { "type": "str", "default": "user", "description": "角色: user/admin/agent" },
        "credits": { "type": "int", "default": 5, "description": "用户积分余额，注册赠送5积分" },
        "created_at": { "type": "str", "description": "注册时间 ISO 格式字符串" }
      },
      "drift": "warning: MVP 规范的 profiles 表使用 UUID 主键、password_hash (Argon2)、tier/plan_type/total_api_calls 字段。Pro 版改为 int 自增主键、hashed_password (bcrypt)、role 字段。MVP 的 tier/plan_type/total_api_calls 在 Pro 中不存在。Pro 新增 phone/full_name 字段。credits 类型从 MVP 的 float 改为 int。"
    },
