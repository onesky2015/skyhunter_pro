      "app/auth/login.tsx": "登录页",
      "app/auth/signup.tsx": "注册页",
      "app/auth/forgot.tsx": "忘记密码页（两步：发送验证码 → 重置密码）"
    },
    "components": {
      "AdminPanel.tsx": "管理员面板 Modal（统计/用户列表/积分调整/删除用户）",
      "AdvancedFilters.tsx": "高级搜索筛选器（转机/时间/航司/联盟/策略）",
      "AirlinePicker.tsx": "航司选择器 Modal",
      "AlliancePicker.tsx": "航空联盟选择器 Modal",
      "CreateMonitorModal.tsx": "创建监控任务 Modal（含询价确认）",
      "DatePicker.tsx": "日期选择器（Web 用 TextInput，Native 用 DateTimePicker）",
