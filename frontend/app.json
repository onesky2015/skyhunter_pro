{
  "expo": {
    "name": "SkyHunter",
    "slug": "skyhunter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "skyhunter",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.skyhunter.flight",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.skyhunter.flight",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      "expo-secure-store"
    ],
    "extra": {
      "googleWebClientId": "511232230562-brr7d7tg5ceqmtcjq0h1aldnijso1l8p.apps.googleusercontent.com",
      "googleIosClientId": "511232230562-v3omoau22ch04bpesqjs60atkqri39mt.apps.googleusercontent.com",
      "googleAndroidClientId": "511232230562-t7rt7ijcvir09cgs0uthgqlhh207tai3.apps.googleusercontent.com",
      "apiUrl": "https://api.skyhunter.app",
      "eas": {
        "projectId": "0d5fde14-f1ce-4b37-bd7a-82d28d09fd57"
      },
      "router": {}
    },
    "owner": "changegim"
  }
}
